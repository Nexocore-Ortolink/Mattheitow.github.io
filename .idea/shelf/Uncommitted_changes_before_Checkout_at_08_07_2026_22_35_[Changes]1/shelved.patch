\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <section class=\"testimonials-section\" id=\"testimonios\">\r\n        <div class=\"container grid-2 align-center\">\r\n            <div class=\"testimonials-media scroll-animate\">\r\n                <div class=\"testimonial-image-wrapper\">\r\n                    <img src=\"images/testimonies_group_hug.png\"\r\n                        alt=\"Grupo de pacientes con prótesis abrazándose\" class=\"testimonial-img\">\r\n                </div>\r\n            </div>\r\n            <div class=\"testimonials-content scroll-animate\">\r\n                <span class=\"section-tag\">Testimonios</span>\r\n                <h2>Historias de éxito que nos inspiran</h2>\r\n\r\n                <div class=\"testimonial-slider\">\r\n                    \r\n                    <div class=\"testimonial-item active\">\r\n                        <div class=\"rating\">\r\n                            <span class=\"material-symbols-rounded fill\">star</span>\r\n                            <span class=\"material-symbols-rounded fill\">star</span>\r\n                            <span class=\"material-symbols-rounded fill\">star</span>\r\n                            <span class=\"material-symbols-rounded fill\">star</span>\r\n                            <span class=\"material-symbols-rounded fill\">star</span>\r\n                        </div>\r\n                        <p class=\"quote\">\r\n                            \"Gracias a las rutinas de OrtoLink y a las alertas de mi prótesis, he vuelto a caminar con\r\n                            seguridad. Mi fisioterapeuta sabe exactamente cómo voy.\"\r\n                        </p>\r\n                        <div class=\"author\">\r\n                            <strong>Carlos M.</strong>\r\n                            <span>Paciente Transtibial (Lima)</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"testimonial-item\">\r\n                        <div class=\"rating\">\r\n                            <span class=\"material-symbols-rounded fill\">star</span>\r\n                            <span class=\"material-symbols-rounded fill\">star</span>\r\n                            <span class=\"material-symbols-rounded fill\">star</span>\r\n                            <span class=\"material-symbols-rounded fill\">star</span>\r\n                            <span class=\"material-symbols-rounded fill\">star</span>\r\n                        </div>\r\n                        <p class=\"quote\">\r\n                            \"OrtoLink me permite ajustar la terapia física de mis pacientes de forma remota y recibir\r\n                            alertas cuando alguien tiene baja adherencia. Ha mejorado los resultados en un 40%.\"\r\n                        </p>\r\n                        <div class=\"author\">\r\n                            <strong>Dra. Andrea R.</strong>\r\n                            <span>Especialista en Medicina Física</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"slider-controls\">\r\n                    <button class=\"btn-ctrl\" id=\"prevTestimonial\" aria-label=\"Testimonio anterior\">\r\n                        <span class=\"material-symbols-rounded\">chevron_left</span>\r\n                    </button>\r\n                    <button class=\"btn-ctrl\" id=\"nextTestimonial\" aria-label=\"Testimonio siguiente\">\r\n                        <span class=\"material-symbols-rounded\">chevron_right</span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <section class=\"registration-section\" id=\"registro\">\r\n        <div class=\"container grid-2 align-center\">\r\n            <div class=\"registration-info scroll-animate\">\r\n                <span class=\"section-tag text-white\">Únete Hoy</span>\r\n                <h2 class=\"text-white\">Únete a OrtoLink hoy mismo</h2>\r\n                <p class=\"text-white-muted\">\r\n                    Regístrate en nuestra plataforma y empieza a experimentar una rehabilitación digital conectada y\r\n                    humana.\r\n                </p>\r\n                <div class=\"reg-benefits-list\">\r\n                    <div class=\"reg-benefit-item\">\r\n                        <span class=\"material-symbols-rounded text-teal\">check_circle</span>\r\n                        <span class=\"text-white\">Acceso inmediato a tu dashboard personal</span>\r\n                    </div>\r\n                    <div class=\"reg-benefit-item\">\r\n                        <span class=\"material-symbols-rounded text-teal\">check_circle</span>\r\n                        <span class=\"text-white\">Soporte técnico continuo 24/7</span>\r\n                    </div>\r\n                    <div class=\"reg-benefit-item\">\r\n                        <span class=\"material-symbols-rounded text-teal\">check_circle</span>\r\n                        <span class=\"text-white\">Seguridad de datos de nivel médico encriptados</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"registration-form-container scroll-animate\">\r\n                \r\n                <div class=\"role-selector\">\r\n                    <button class=\"btn-role active\" id=\"btnRolePatient\">Soy Paciente</button>\r\n                    <button class=\"btn-role\" id=\"btnRoleSpecialist\">Soy Especialista</button>\r\n                </div>\r\n\r\n                <form id=\"regForm\" class=\"reg-form\">\r\n                    <h3 id=\"formTitle\">Crear mi cuenta de Paciente</h3>\r\n\r\n                    <div class=\"form-group\">\r\n                        <label for=\"regName\">Nombre y Apellidos</label>\r\n                        <input type=\"text\" id=\"regName\" placeholder=\"Escribe tu nombre completo\" required>\r\n                    </div>\r\n\r\n                    <div class=\"form-group\">\r\n                        <label for=\"regEmail\">Correo Electrónico</label>\r\n                        <input type=\"email\" id=\"regEmail\" placeholder=\"ejemplo@correo.com\" required>\r\n                    </div>\r\n\r\n                    <div class=\"form-group\">\r\n                        <label for=\"regPassword\">Contraseña</label>\r\n                        <input type=\"password\" id=\"regPassword\" placeholder=\"Crea una contraseña segura\" required\r\n                            minlength=\"6\">\r\n                    </div>\r\n\r\n                    <div class=\"form-group\" id=\"groupAmputation\">\r\n                        <label for=\"regAmputation\">Tipo de Amputación</label>\r\n                        <select id=\"regAmputation\" required>\r\n                            <option value=\"\" disabled selected>Selecciona tu tipo de amputación</option>\r\n                            <option value=\"transtibial\">Transtibial (Bajo la rodilla)</option>\r\n                            <option value=\"transfemoral\">Transfemoral (Sobre la rodilla)</option>\r\n                            <option value=\"brazo\">Miembro Superior (Brazo / Mano)</option>\r\n                            <option value=\"otro\">Otro tipo</option>\r\n                        </select>\r\n                    </div>\r\n\r\n                    <div class=\"form-group hidden\" id=\"groupSpecialty\">\r\n                        <label for=\"regSpecialty\">Especialidad</label>\r\n                        <select id=\"regSpecialty\">\r\n                            <option value=\"\" disabled selected>Selecciona tu especialidad</option>\r\n                            <option value=\"fisioterapia\">Fisioterapeuta</option>\r\n                            <option value=\"protesista\">Protesista</option>\r\n                            <option value=\"rehabilitador\">Médico Fisiatra / Rehabilitador</option>\r\n                            <option value=\"otra\">Otra especialidad</option>\r\n                        </select>\r\n                    </div>\r\n\r\n                    <div class=\"form-group hidden\" id=\"groupLicense\">\r\n                        <label for=\"regLicense\">Número de Colegiatura Médica</label>\r\n                        <input type=\"text\" id=\"regLicense\" placeholder=\"Ingresa tu CTMP o CMP\">\r\n                    </div>\r\n\r\n                    <button type=\"submit\" class=\"btn btn-primary btn-block\" id=\"btnSubmitForm\">Crear mi cuenta</button>\r\n\r\n                    <p class=\"form-notice\" id=\"formNotice\"></p>\r\n                </form>\r\n            </div>\r\n        </div>\r\n    </section>\r\n    \r\n    <section class=\"faq-section\" id=\"faqs\">\r\n        <div class=\"container\">\r\n            <div class=\"section-header text-center scroll-animate\">\r\n                <span class=\"section-tag\">Preguntas Frecuentes</span>\r\n                <h2>Resolveremos tus dudas</h2>\r\n                <p class=\"section-desc\">\r\n                    ¿Tienes preguntas sobre OrtoLink? Aquí respondemos las dudas más comunes de nuestros pacientes y especialistas.\r\n                </p>\r\n            </div>\r\n\r\n            <div class=\"faq-accordion-container scroll-animate\">\r\n                \r\n                <div class=\"faq-item\">\r\n                    <button class=\"faq-question\" aria-expanded=\"false\">\r\n                        <span>¿Cómo se conecta OrtoLink con mi prótesis?</span>\r\n                        <span class=\"material-symbols-rounded faq-arrow\">expand_more</span>\r\n                    </button>\r\n                    <div class=\"faq-answer\">\r\n                        <div class=\"faq-answer-inner\">\r\n                            <p>\r\n                                OrtoLink no requiere una conexión física directa por cable ni sensores invasivos. La aplicación te permite registrar manualmente el estado y revisiones de tu prótesis y el socket. Además, el algoritmo de la plataforma genera alertas preventivas de mantenimiento basadas en tu tiempo de uso registrado y reportes de comodidad diaria.\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"faq-item\">\r\n                    <button class=\"faq-question\" aria-expanded=\"false\">\r\n                        <span>¿Cómo ayuda OrtoLink en el control del dolor fantasma?</span>\r\n                        <span class=\"material-symbols-rounded faq-arrow\">expand_more</span>\r\n                    </button>\r\n                    <div class=\"faq-answer\">\r\n                        <div class=\"faq-answer-inner\">\r\n                            <p>\r\n                                La plataforma cuenta con un Diario de Dolor Fantasma digital. Los pacientes pueden registrar la intensidad (escala 1-10), frecuencia y tipo de molestia que experimentan. El sistema analiza esta información, ofrece técnicas inmediatas de alivio basadas en evidencia clínica (como ejercicios de respiración, masajes o terapia de espejo) y envía un reporte automatizado a su especialista tratante para ajustar el tratamiento físico.\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"faq-item\">\r\n                    <button class=\"faq-question\" aria-expanded=\"false\">\r\n                        <span>Soy especialista, ¿cómo puedo ver el progreso de mis pacientes?</span>\r\n                        <span class=\"material-symbols-rounded faq-arrow\">expand_more</span>\r\n                    </button>\r\n                    <div class=\"faq-answer\">\r\n                        <div class=\"faq-answer-inner\">\r\n                            <p>\r\n                                Al registrarte como especialista y ser verificado por nuestro equipo médico, accedes a un panel de control clínico (Dashboard). Desde allí puedes visualizar en tiempo real gráficos sobre la adherencia a los ejercicios de tus pacientes, la curva de dolor fantasma y alertas en caso de que algún paciente reporte una disminución significativa en su movilidad o confort del socket.\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"faq-item\">\r\n                    <button class=\"faq-question\" aria-expanded=\"false\">\r\n                        <span>¿Mis datos médicos y reportes clínicos están seguros?</span>\r\n                        <span class=\"material-symbols-rounded faq-arrow\">expand_more</span>\r\n                    </button>\r\n                    <div class=\"faq-answer\">\r\n                        <div class=\"faq-answer-inner\">\r\n                            <p>\r\n                                Absolutamente. En Nexocore nos tomamos muy en serio la privacidad clínica. Toda la información personal y los reportes de salud registrados en OrtoLink están encriptados de extremo a extremo y son almacenados bajo normativas de seguridad de nivel médico (cumpliendo con estándares internacionales de protección de datos de salud), garantizando que solo tú y tu especialista autorizado puedan verlos.\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <section class=\"contact-section\" id=\"contacto\">\r\n        <div class=\"container\">\r\n            <div class=\"contact-card scroll-animate\">\r\n                <div class=\"contact-card-grid\">\r\n                    <div class=\"contact-info-area\">\r\n                        <h3>¿Surgió alguna duda o consulta?</h3>\r\n                        <p>Nuestro equipo de soporte técnico y asesores clínicos de Nexocore están listos para ayudarte\r\n                            en lo que necesites.</p>\r\n\r\n                        <div class=\"contact-methods\">\r\n                            <div class=\"method-item\">\r\n                                <span class=\"material-symbols-rounded\">mail</span>\r\n                                <span>soporte@nexocore.com.pe</span>\r\n                            </div>\r\n                            <div class=\"method-item\">\r\n                                <span class=\"material-symbols-rounded\">call</span>\r\n                                <span>+51 1 619-7000</span>\r\n                            </div>\r\n                            <div class=\"method-item\">\r\n                                <span class=\"material-symbols-rounded\">location_on</span>\r\n                                <span>Santiago de Surco, Lima, Perú</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"contact-form-area\">\r\n                        <form id=\"contactForm\" class=\"contact-form\">\r\n                            <div class=\"form-group\">\r\n                                <input type=\"text\" id=\"contactName\" placeholder=\"Escribe tu nombre\" required>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <input type=\"email\" id=\"contactEmail\" placeholder=\"Tu correo electrónico\" required>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <textarea id=\"contactMessage\" rows=\"4\"\r\n                                    placeholder=\"Escribe tu consulta detalladamente...\" required></textarea>\r\n                            </div>\r\n                            <button type=\"submit\" class=\"btn btn-secondary btn-block\">Enviar consulta</button>\r\n                            <p class=\"form-notice\" id=\"contactNotice\"></p>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n   \r\n    <footer class=\"main-footer\">\r\n        <div class=\"container footer-grid\">\r\n            <div class=\"footer-brand\">\r\n                <a href=\"#inicio\" class=\"logo-area text-white\">\r\n                    <img src=\"images/Ortolink logo sin fondo.png\" alt=\"OrtoLink Logo\" class=\"logo-img\">\r\n                    <span class=\"logo-text\">OrtoLink</span>\r\n                </a>\r\n                <p class=\"brand-desc\">\r\n                    Rehabilitación conectada, progreso acompañado. Cerrando la brecha clínica post-protésica en el Perú.\r\n                </p>\r\n                <div class=\"social-links\">\r\n                    <a href=\"#\" aria-label=\"Facebook\"><span class=\"material-symbols-rounded\">public</span></a>\r\n                    <a href=\"#\" aria-label=\"LinkedIn\"><span class=\"material-symbols-rounded\">group</span></a>\r\n                    <a href=\"#\" aria-label=\"YouTube\"><span class=\"material-symbols-rounded\">video_library</span></a>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"footer-links\">\r\n                <h4>Enlaces rápidos</h4>\r\n                <ul>\r\n                    <li><a href=\"#inicio\">Inicio</a></li>\r\n                    <li><a href=\"#sobre-nosotros\">Sobre Nosotros</a></li>\r\n                    <li><a href=\"#beneficios\">Beneficios</a></li>\r\n                    <li><a href=\"#testimonios\">Testimonios</a></li>\r\n                </ul>\r\n            </div>\r\n\r\n            <div class=\"footer-links\">\r\n                <h4>Legal y Términos</h4>\r\n                <ul>\r\n                    <li><a href=\"#\" class=\"legal-link\" data-legal=\"terms\">Términos y condiciones</a></li>\r\n                    <li><a href=\"