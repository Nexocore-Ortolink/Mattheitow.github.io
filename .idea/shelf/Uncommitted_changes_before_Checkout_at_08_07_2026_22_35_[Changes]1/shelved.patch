gba(0, 86, 210, 0.08);\r\n}\r\n\r\n.demo-card-grid {\r\n    display: grid;\r\n    grid-template-columns: 1fr;\r\n    gap: 32px;\r\n    align-items: center;\r\n}\r\n\r\n@media (min-width: 992px) {\r\n    .demo-card-grid {\r\n        grid-template-columns: 1fr 1fr;\r\n        gap: 48px;\r\n    }\r\n}\r\n\r\n.demo-info h3 {\r\n    font-size: 1.75rem;\r\n    margin: 12px 0;\r\n    color: var(--color-primary);\r\n}\r\n\r\n.demo-info p {\r\n    color: var(--color-text-muted);\r\n    margin-bottom: 0;\r\n}\r\n\r\n.pain-scale-container {\r\n    background-color: var(--color-bg-light);\r\n    border-radius: var(--radius-card);\r\n    padding: 32px;\r\n    border: 1px solid rgba(0, 86, 210, 0.03);\r\n    transition: var(--transition-smooth);\r\n}\r\n\r\n.pain-faces {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    margin-bottom: 24px;\r\n    padding: 0 10px;\r\n}\r\n\r\n.face {\r\n    font-size: 2rem;\r\n    cursor: pointer;\r\n    transition: transform 0.2s ease, filter 0.2s ease;\r\n    filter: grayscale(80%) opacity(60%);\r\n}\r\n\r\n.face:hover {\r\n    transform: scale(1.2);\r\n    filter: grayscale(0%) opacity(100%);\r\n}\r\n\r\n.face.active {\r\n    transform: scale(1.3);\r\n    filter: grayscale(0%) opacity(100%);\r\n}\r\n\r\n.pain-slider-wrapper {\r\n    margin-bottom: 24px;\r\n}\r\n\r\n.pain-slider {\r\n    width: 100%;\r\n    -webkit-appearance: none;\r\n    appearance: none;\r\n    height: 8px;\r\n    border-radius: 4px;\r\n    background: var(--color-disabled);\r\n    outline: none;\r\n    transition: background 0.3s;\r\n}\r\n\r\n.pain-slider::-webkit-slider-thumb {\r\n    -webkit-appearance: none;\r\n    appearance: none;\r\n    width: 24px;\r\n    height: 24px;\r\n    border-radius: 50%;\r\n    background: var(--color-primary);\r\n    cursor: pointer;\r\n    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);\r\n    transition: transform 0.1s, background-color 0.3s;\r\n}\r\n\r\n.pain-slider::-webkit-slider-thumb:hover {\r\n    transform: scale(1.15);\r\n}\r\n\r\n.pain-slider::-moz-range-thumb {\r\n    width: 24px;\r\n    height: 24px;\r\n    border-radius: 50%;\r\n    background: var(--color-primary);\r\n    cursor: pointer;\r\n    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);\r\n    transition: transform 0.1s, background-color 0.3s;\r\n    border: none;\r\n}\r\n\r\n.pain-slider::-moz-range-thumb:hover {\r\n    transform: scale(1.15);\r\n}\r\n\r\n.pain-value-display {\r\n    text-align: center;\r\n    margin-top: 12px;\r\n    font-size: 0.938rem;\r\n    font-weight: 500;\r\n    color: var(--color-text-dark);\r\n}\r\n\r\n.pain-value-display strong {\r\n    font-size: 1.25rem;\r\n    color: var(--color-primary);\r\n    transition: color 0.3s;\r\n}\r\n\r\n.pain-recommendation {\r\n    display: flex;\r\n    gap: 16px;\r\n    padding: 20px;\r\n    border-radius: var(--radius-btn);\r\n    background-color: var(--color-white);\r\n    border: 1px solid var(--color-disabled);\r\n    transition: var(--transition-smooth);\r\n    min-height: 100px;\r\n}\r\n\r\n.pain-recommendation span:first-child {\r\n    font-size: 2rem;\r\n    color: var(--color-secondary);\r\n    flex-shrink: 0;\r\n    transition: color 0.3s;\r\n}\r\n\r\n.pain-recommendation strong {\r\n    display: block;\r\n    font-size: 0.938rem;\r\n    color: var(--pain-color, var(--color-primary));\r\n    margin-bottom: 4px;\r\n    transition: color 0.3s;\r\n}\r\n\r\n.pain-recommendation p {\r\n    font-size: 0.875rem;\r\n    color: var(--color-text-muted);\r\n    line-height: 1.5;\r\n}\r\n\r\n.pain-scale-container {\r\n    --pain-color: var(--color-primary);\r\n    background-color: var(--color-bg-light);\r\n    border-radius: var(--radius-card);\r\n    padding: 32px;\r\n    border: 1px solid rgba(0, 86, 210, 0.03);\r\n    transition: var(--transition-smooth);\r\n}\r\n\r\n.pain-scale-container.pain-green {\r\n    --pain-color: #00A896; \r\n    background-color: rgba(0, 168, 150, 0.03);\r\n    border-color: rgba(0, 168, 150, 0.15);\r\n}\r\n\r\n.pain-scale-container.pain-teal {\r\n    --pain-color: #008f7f;\r\n    background-color: rgba(0, 143, 127, 0.03);\r\n    border-color: rgba(0, 143, 127, 0.15);\r\n}\r\n\r\n.pain-scale-container.pain-orange {\r\n    --pain-color: #FF8C00; \r\n    background-color: rgba(255, 140, 0, 0.03);\r\n    border-color: rgba(255, 140, 0, 0.15);\r\n}\r\n\r\n.pain-scale-container.pain-red {\r\n    --pain-color: #e63946; \r\n    background-color: rgba(230, 57, 70, 0.03);\r\n    border-color: rgba(230, 57, 70, 0.15);\r\n}\r\n\r\n.pain-scale-container.pain-critical {\r\n    --pain-color: #9b2226; \r\n    background-color: rgba(155, 34, 38, 0.04);\r\n    border-color: rgba(155, 34, 38, 0.2);\r\n}\r\n\r\n.pain-slider::-webkit-slider-thumb {\r\n    background: var(--pain-color, var(--color-primary)) !important;\r\n}\r\n\r\n.pain-slider::-moz-range-thumb {\r\n    background: var(--pain-color, var(--color-primary)) !important;\r\n}\r\n\r\n.pain-value-display strong {\r\n    color: var(--pain-color, var(--color-primary)) !important;\r\n}\r\n\r\n.pain-recommendation span:first-child {\r\n    color: var(--pain-color, var(--color-secondary)) !important;\r\n}\r\n\r\n.fade-in-slide {\r\n    animation: fadeInSlide 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;\r\n}\r\n\r\n@keyframes fadeInSlide {\r\n    from {\r\n        opacity: 0;\r\n        transform: translateY(10px);\r\n    }\r\n    to {\r\n        opacity: 1;\r\n        transform: translateY(0);\r\n    }\r\n}
