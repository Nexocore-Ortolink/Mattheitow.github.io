<+><!DOCTYPE html>\r\n<html lang=\"es\">\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>OrtoLink - Rehabilitación conectada, progreso acompañado</title>\r\n\r\n    <meta name=\"description\"\r\n        content=\"OrtoLink es la plataforma digital que conecta a pacientes amputados con especialistas en rehabilitación. Rutinas guiadas, diario de dolor y monitoreo remoto.\">\r\n    <meta name=\"keywords\"\r\n        content=\"rehabilitacion, protesis, amputados, dolor fantasma, telemedicina, ortopedia, fisioterapia, peru\">\r\n    <meta name=\"author\" content=\"Nexocore\">\r\n\r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\r\n\r\n    <link rel=\"stylesheet\"\r\n        href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0..1,0&display=swap\" />\r\n\r\n    <link rel=\"stylesheet\" href=\"css/style.css?v=1.0.1\">\r\n</head>\r\n\r\n<body>\r\n  \r\n    <header class=\"main-header\" id=\"header\">\r\n        <div class=\"header-container\">\r\n            <a href=\"#inicio\" class=\"logo-area\">\r\n                <img src=\"images/Ortolink logo sin fondo.png\" alt=\"OrtoLink Logo\" class=\"logo-img\">\r\n                <span class=\"logo-text\">OrtoLink</span>\r\n            </a>\r\n\r\n            <button class=\"mobile-menu-toggle\" id=\"menuToggle\" aria-label=\"Abrir menú de navegación\">\r\n                <span class=\"material-symbols-rounded\">menu</span>\r\n            </button>\r\n\r\n            <nav class=\"nav-menu\" id=\"navMenu\">\r\n                <a href=\"#inicio\" class=\"nav-link active\">Inicio</a>\r\n                <a href=\"#sobre-nosotros\" class=\"nav-link\">Sobre Nosotros</a>\r\